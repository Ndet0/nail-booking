{
  "name": "nailsbychao",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.e2e.json",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "pnpm --filter @nailsbychao/api db:migrate:local",
    "db:seed:local": "pnpm --filter @nailsbychao/api db:seed:local",
    "admin:create": "pnpm --filter @nailsbychao/api admin:create",
    "admin:set-password": "pnpm --filter @nailsbychao/api admin:set-password"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
