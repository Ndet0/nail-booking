{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nailsbychao-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "development",
    "CORS_ORIGINS": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nailsbychao-db",
      // Local `wrangler dev` and `--local` commands do not use this id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nailsbychao-gallery"
    }
  ],
  "env": {
    "production": {
      "name": "www",
      "vars": {
        "ENVIRONMENT": "production",
        "CORS_ORIGINS": "https://www.nailsbychao.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nailsbychao-db",
          "database_id": "5e9816e1-e6a4-4060-a105-a0c3c8209ffa",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nailsbychao-gallery"
        }
      ],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
