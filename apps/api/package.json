{
  "name": "@nailsbychao/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nailsbychao-db --local",
    "db:seed:local": "wrangler d1 execute nailsbychao-db --local --file seed/services.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@nailsbychao/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261027.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.154.0"
  }
}
